# ==============================================================================
# CFASS Backend Environment Variables
# Faculty of Computing, University of Calabar
# ==============================================================================

PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas URI or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cfass_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/cfass_db

# JSON Web Token Secret & Expiration
JWT_SECRET=cfass_unical_secret_jwt_key_2024_audit_defense
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
CLIENT_URL=http://localhost:5173
